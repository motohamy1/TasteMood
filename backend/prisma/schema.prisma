generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String                 @id @default(uuid())
  authUserId        String                 @unique
  email             String?
  displayName       String
  role              UserRole               @default(USER)
  avatarUrl         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  interactions      UserInteraction[]
  preferenceProfile UserPreferenceProfile?

  @@map("users")
}

model UserPreferenceProfile {
  id                    String               @id @default(uuid())
  userId                String               @unique
  preferredCuisines     String[]             @default([])
  dislikedCuisines      String[]             @default([])
  preferredPriceRange   PriceRange?
  dietaryRestrictions   DietaryProperty[]    @default([])
  spicePreference       Int                  @default(2)
  preferredMealTypes    MealCharacteristic[] @default([])
  atmospherePreferences String[]             @default([])
  inferredPreferences   Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference_profiles")
}

model UserInteraction {
  id              String          @id @default(uuid())
  userId          String
  restaurantId    String?
  branchId        String?
  dishId          String?
  interactionType InteractionType
  metadata        Json?
  createdAt       DateTime        @default(now())
  branch          Branch?         @relation(fields: [branchId], references: [id])
  dish            Dish?           @relation(fields: [dishId], references: [id])
  restaurant      Restaurant?     @relation(fields: [restaurantId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, interactionType])
  @@index([restaurantId])
  @@index([dishId])
  @@map("user_interactions")
}

model Governorate {
  id       String   @id @default(uuid())
  nameEn   String   @unique
  nameAr   String   @unique
  slug     String   @unique
  branches Branch[]
  cities   City[]

  @@map("governorates")
}

model City {
  id            String      @id @default(uuid())
  governorateId String
  nameEn        String
  nameAr        String
  slug          String
  latitude      Float?
  longitude     Float?
  branches      Branch[]
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)

  @@unique([governorateId, slug])
  @@index([nameEn])
  @@map("cities")
}

model Restaurant {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  description        String?
  priceRange         PriceRange          @default(MODERATE)
  status             RecordStatus        @default(ACTIVE)
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  lastVerifiedAt     DateTime?
  source             String              @default("MANUAL")
  logoUrl            String?
  coverImageUrl      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  nameEn             String?
  photoAttribution   String?
  branches           Branch[]
  menus              Menu[]
  cuisines           RestaurantCuisine[]
  interactions       UserInteraction[]

  @@index([status, verificationStatus])
  @@map("restaurants")
}

model Cuisine {
  id          String              @id @default(uuid())
  name        String              @unique
  slug        String              @unique
  description String?
  createdAt   DateTime            @default(now())
  nameAr      String?
  restaurants RestaurantCuisine[]

  @@map("cuisines")
}

model RestaurantCuisine {
  restaurantId String
  cuisineId    String
  cuisine      Cuisine    @relation(fields: [cuisineId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineId])
  @@map("restaurant_cuisines")
}

model Branch {
  id                 String                @id @default(uuid())
  restaurantId       String
  name               String
  address            String
  latitude           Float
  longitude          Float
  phone              String?
  status             RecordStatus          @default(ACTIVE)
  verificationStatus VerificationStatus    @default(UNVERIFIED)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  cityId             String?
  externalId         String?               @unique
  governorateId      String?
  nameEn             String?
  coverImageUrl      String?
  photoAttribution   String?
  source             String                @default("MANUAL")
  // What kind of place this is (cafe, bakery, restaurant, ...). Drives how the
  // app groups and labels places. Optional: not every source reports it.
  placeKind          String?
  // Optional source provenance. NOT a display requirement: a place with no
  // rating is still discoverable, because discovery is coordinate-based.
  rating             Decimal?              @db.Decimal(2, 1)
  reviewsCount       Int?
  googleMapsUrl      String?
  sourceAcquiredAt   DateTime?
  atmospheres        BranchAtmosphere[]
  operatingHours     BranchOperatingHour[]
  city               City?                 @relation(fields: [cityId], references: [id])
  governorate        Governorate?          @relation(fields: [governorateId], references: [id])
  restaurant         Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menus              Menu[]
  interactions       UserInteraction[]
  photos             PlacePhoto[]

  @@index([restaurantId])
  @@index([latitude, longitude])
  @@index([cityId])
  @@index([governorateId])
  @@index([placeKind])
  @@map("branches")
}

/// Photos attached to a branch. We store both imported URLs
/// (CSV) and Wikimedia Commons lookups (enrichment).
model PlacePhoto {
  id            String   @id @default(uuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  url           String
  thumbUrl      String?
  caption       String?
  /// Type tag from the source (cover_photo, menu, menu_board, product_photo, ...).
  /// Stored as a free string for now to support the long tail of CSV photo types.
  photoType     String
  source        String   @default("CSV")
  attribution   String?
  /// When the photo was originally posted (yyyy-MM-dd), if available.
  takenAt       DateTime?
  createdAt     DateTime @default(now())

  @@index([branchId, photoType])
  @@map("place_photos")
}

model BranchOperatingHour {
  id           String  @id @default(uuid())
  branchId     String
  dayOfWeek    Int
  openTime     String
  closeTime    String
  isClosed     Boolean @default(false)
  isSplitShift Boolean @default(false)
  branch       Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, dayOfWeek])
  @@map("branch_operating_hours")
}

model AtmosphereTag {
  id          String             @id @default(uuid())
  name        String             @unique
  slug        String             @unique
  description String?
  branches    BranchAtmosphere[]

  @@map("atmosphere_tags")
}

model BranchAtmosphere {
  branchId        String
  atmosphereTagId String
  atmosphereTag   AtmosphereTag @relation(fields: [atmosphereTagId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([branchId, atmosphereTagId])
  @@map("branch_atmospheres")
}

model Menu {
  id            String       @id @default(uuid())
  restaurantId  String
  branchId      String?
  name          String
  description   String?
  status        RecordStatus @default(ACTIVE)
  source        String       @default("MANUAL")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  dishes        Dish[]
  branch        Branch?      @relation(fields: [branchId], references: [id])
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([branchId])
  @@map("menus")
}

model Dish {
  id                 String                   @id @default(uuid())
  menuId             String
  name               String
  slug               String
  description        String?
  price              Float
  currency           String                   @default("EGP")
  imageUrl           String?
  status             RecordStatus             @default(ACTIVE)
  verificationStatus VerificationStatus       @default(UNVERIFIED)
  lastVerifiedAt     DateTime?
  source             String                   @default("MANUAL")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  descriptionEn      String?
  nameEn             String?
  attributes         DishAttribute?
  categories         DishCategoryAssignment[]
  ingredients        DishIngredient[]
  priceHistory       DishPriceHistory[]
  tags               DishTag[]
  menu               Menu                     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  interactions       UserInteraction[]

  @@index([menuId])
  @@index([status, price])
  @@map("dishes")
}

model DishCategory {
  id          String                   @id @default(uuid())
  name        String                   @unique
  slug        String                   @unique
  description String?
  dishes      DishCategoryAssignment[]

  @@map("dish_categories")
}

model DishCategoryAssignment {
  dishId     String
  categoryId String
  category   DishCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dish       Dish         @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([dishId, categoryId])
  @@map("dish_category_assignments")
}

model DishAttribute {
  id                  String               @id @default(uuid())
  dishId              String               @unique
  tasteAttributes     TasteAttribute[]     @default([])
  textures            String[]             @default([])
  mealCharacteristics MealCharacteristic[] @default([])
  dietaryProperties   DietaryProperty[]    @default([])
  dish                Dish                 @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@map("dish_attributes")
}

model Ingredient {
  id          String           @id @default(uuid())
  name        String           @unique
  slug        String           @unique
  description String?
  dishes      DishIngredient[]

  @@map("ingredients")
}

model DishIngredient {
  dishId       String
  ingredientId String
  isOptional   Boolean    @default(false)
  isAllergen   Boolean    @default(false)
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([dishId, ingredientId])
  @@map("dish_ingredients")
}

model FoodTag {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  dishes      DishTag[]

  @@map("food_tags")
}

model DishTag {
  dishId String
  tagId  String
  dish   Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  tag    FoodTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dishId, tagId])
  @@map("dish_tags")
}

model DishPriceHistory {
  id            String    @id @default(uuid())
  dishId        String
  price         Float
  currency      String    @default("EGP")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  source        String    @default("MANUAL")
  dish          Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId, effectiveFrom])
  @@map("dish_price_history")
}

enum UserRole {
  USER
  ADMIN
  RESTAURANT_OWNER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  NEEDS_REVIEW
}

enum PriceRange {
  BUDGET
  MODERATE
  EXPENSIVE
  LUXURY
}

enum InteractionType {
  VIEW_RESTAURANT
  VIEW_DISH
  CLICK_RECOMMENDATION
  LIKE
  DISLIKE
  NOT_INTERESTED
  TOO_EXPENSIVE
  TOO_FAR
  WRONG_TASTE
  SAVED
  SHARED
}

enum TasteAttribute {
  SPICY
  SWEET
  SAVORY
  SOUR
  BITTER
  CREAMY
  RICH
  REFRESHING
}

enum MealCharacteristic {
  LIGHT
  HEAVY
  FILLING
  SNACK
  BREAKFAST
  LUNCH
  DINNER
  DESSERT
  BEVERAGE
}

enum DietaryProperty {
  VEGETARIAN
  VEGAN
  HALAL
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
  LOW_CARB
}
