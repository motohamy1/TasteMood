# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Database (Supabase PostgreSQL / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tastemood?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tastemood?schema=public"

# Supabase Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Provider Configuration (mock | gemini | openai)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Default Currency & Recommendation Weights
DEFAULT_CURRENCY=EGP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20
